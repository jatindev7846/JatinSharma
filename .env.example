# Copy to .env (local) or set these in your hosting dashboard (Vercel / Netlify / ...).
# Vite reads them at BUILD time, so redeploy after changing them.

# Google Analytics 4 Measurement ID (analytics.google.com -> Admin -> Data streams -> Web)
VITE_GA_ID=

# Contact form: Google Apps Script URL (see contact-sheet/README.md) or a Formspree URL
VITE_CONTACT_ENDPOINT=

# Optional: email shown on the site and used by the mailto fallback
VITE_CONTACT_EMAIL=
